# SocialPulse Environment Configuration

# App Mode
MOCK_FETCH_MODE=true
MOCK_AI_MODE=true

# Database Path
DB_PATH=socialpulse.db

# Pipeline Scheduler Interval
PIPELINE_INTERVAL_MINUTES=15

# Reused Keys (from PulseDesk)
NEWSAPI_KEY=
GNEWS_KEY=
GEMINI_KEY=

# Category A APIs
# YouTube Data API v3 Key:
# 1. Open Google Cloud Console (https://console.cloud.google.com/)
# 2. Create or select a project, enable "YouTube Data API v3"
# 3. Navigate to APIs & Services > Credentials > Create Credentials > API Key
# 4. Paste the generated key here (starts with 'AIzaSy...')
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SocialPulse/1.0
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Stretch Goals
PINTEREST_ACCESS_TOKEN=
